// Job-search companion — data model
//
// Persona: ONE user (you), tracking the many recruitment processes you are
// going through as a candidate. Everything hangs off `User`.
//
// Design notes carried over from the process engine:
// - A ProcessTemplate is a reusable *standard flow*. When you start tracking an
//   Opportunity, the template's stages are COPIED into OpportunityStage rows.
//   The opportunity then owns its flow, so you can personalize one company's
//   process (they added a founder chat; they waived the take-home) without
//   touching the template or any other opportunity.
// - Google sync watches YOUR mailbox. Recruiter mail is matched to the right
//   opportunity by contact address or company domain, then replayed through the
//   automation engine, which may advance the stage.
// - The assistant never sends email on its own. It writes an EmailDraft; you
//   approve and send.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// You
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatarUrl String?
  headline  String?
  /// Free-text context the assistant uses when drafting on your behalf:
  /// seniority, stack, what you're looking for, salary expectations.
  profile   String?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  googleAccount    GoogleAccount?
  companies        Company[]
  contacts         Contact[]
  templates        ProcessTemplate[]
  opportunities    Opportunity[]
  activities       Activity[]
  emails           EmailMessage[]
  emailDrafts      EmailDraft[]
  calendarEvents   CalendarEvent[]
  driveFiles       DriveFile[]
  challenges       Challenge[]
  assistantThreads AssistantThread[]
  automationRules  AutomationRule[]
  notes            Note[]
  syncRuns         SyncRun[]
}

/// OAuth tokens + per-provider incremental sync cursors.
model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  email        String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scopes       String[]  @default([])

  gmailHistoryId      String?
  calendarSyncToken   String?
  driveStartPageToken String?

  syncEnabled  Boolean   @default(true)
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Companies & the people at them
// ---------------------------------------------------------------------------

model Company {
  id      String   @id @default(cuid())
  userId  String
  name    String
  /// Email domains that identify this company, e.g. ["acme.com", "acme.io"].
  /// This is how recruiter mail from an unknown address still gets matched.
  domains String[] @default([])
  website String?
  notes   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  opportunities Opportunity[]

  @@unique([userId, name])
  @@index([userId])
}

enum ContactRole {
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  REFERRAL
  OTHER
}

model Contact {
  id        String      @id @default(cuid())
  userId    String
  companyId String?
  name      String
  email     String
  role      ContactRole @default(RECRUITER)
  title     String?
  linkedinUrl String?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([userId, email])
  @@index([userId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Standard flows
// ---------------------------------------------------------------------------

/// Semantic meaning of a stage. Automations key off this rather than the name,
/// so "Tech Screen" and "Entrevista Técnica" behave alike.
enum StageType {
  RESEARCHING
  APPLIED
  RECRUITER_SCREEN
  TAKE_HOME
  TECHNICAL_INTERVIEW
  BEHAVIOURAL_INTERVIEW
  ONSITE
  SYSTEM_DESIGN
  REFERENCE_CHECK
  OFFER
  ACCEPTED
  REJECTED
  CUSTOM
}

model ProcessTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages        TemplateStage[]
  opportunities Opportunity[]

  @@unique([userId, name])
  @@index([userId])
}

model TemplateStage {
  id          String    @id @default(cuid())
  templateId  String
  name        String
  /// Stable machine key, e.g. "tech_interview". Used by automation rules.
  key         String
  type        StageType @default(CUSTOM)
  position    Int
  /// Days you'd expect to wait here before chasing them.
  chaseAfterDays Int?
  description String?

  template ProcessTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId])
}

// ---------------------------------------------------------------------------
// Opportunities — one recruitment process you are going through
// ---------------------------------------------------------------------------

enum OpportunityStatus {
  ACTIVE
  ON_HOLD
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
  GHOSTED
}

enum FlowMode {
  /// Follows the template exactly.
  STANDARD
  /// Stages were added / skipped / reordered for this company.
  PERSONALIZED
}

enum Priority {
  DREAM
  HIGH
  MEDIUM
  LOW
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

model Opportunity {
  id         String            @id @default(cuid())
  userId     String
  companyId  String
  templateId String
  roleTitle  String
  status     OpportunityStatus @default(ACTIVE)
  flowMode   FlowMode          @default(STANDARD)
  priority   Priority          @default(MEDIUM)

  currentStageId String? @unique

  location    String?
  workMode    WorkMode?
  jobPostUrl  String?
  source      String?
  salaryMin   Int?
  salaryMax   Int?
  currency    String?   @default("EUR")
  /// Your own 1-5 read on how excited you are.
  excitement  Int?
  notesSummary String?

  /// What you owe them (or they owe you) next, surfaced on the dashboard.
  nextAction   String?
  nextActionAt DateTime?

  /// Gmail thread the correspondence lives in.
  emailThreadId String?
  driveFolderId String?

  /// Set when the inbox scanner created this from an application confirmation
  /// rather than you typing it in. Auto-detected rows are live immediately —
  /// this only drives the "we picked this up, is it right?" banner.
  autoDetected     Boolean   @default(false)
  /// Which system the confirmation came from: "LinkedIn", "Greenhouse", …
  detectedFrom     String?
  /// Gmail id of the confirmation, so the guess is always traceable.
  detectionEmailId String?
  /// Set once you confirm or correct an auto-detected row.
  confirmedAt      DateTime?

  appliedAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  closedAt       DateTime?
  closeReason    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template       ProcessTemplate   @relation(fields: [templateId], references: [id])
  currentStage   OpportunityStage? @relation("CurrentStage", fields: [currentStageId], references: [id])
  stages         OpportunityStage[] @relation("OpportunityStages")
  transitions    StageTransition[]
  activities     Activity[]
  notes          Note[]
  emails         EmailMessage[]
  emailDrafts    EmailDraft[]
  calendarEvents CalendarEvent[]
  driveFiles     DriveFile[]
  challenges     Challenge[]
  threads        AssistantThread[]

  @@unique([userId, companyId, roleTitle])
  @@index([userId, status])
  @@index([userId, lastActivityAt])
}

enum StageStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
  FAILED
}

/// A per-opportunity copy of a template stage. Owning the copy is what makes
/// personalization safe: edits here never touch the template.
model OpportunityStage {
  id            String      @id @default(cuid())
  opportunityId String
  templateStageId String?
  name          String
  key           String
  type          StageType   @default(CUSTOM)
  position      Int
  status        StageStatus @default(PENDING)
  chaseAfterDays Int?
  notes         String?
  /// True when this stage does not come from the template.
  isCustom      Boolean     @default(false)
  enteredAt     DateTime?
  completedAt   DateTime?
  chaseAt       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  opportunity     Opportunity       @relation("OpportunityStages", fields: [opportunityId], references: [id], onDelete: Cascade)
  currentOf       Opportunity?      @relation("CurrentStage")
  fromTransitions StageTransition[] @relation("FromStage")
  toTransitions   StageTransition[] @relation("ToStage")
  calendarEvents  CalendarEvent[]
  challenges      Challenge[]

  @@unique([opportunityId, key])
  @@index([opportunityId, position])
}

/// Who or what caused a change.
enum ActorType {
  USER
  ASSISTANT
  AUTOMATION
  SYNC
  SYSTEM
}

model StageTransition {
  id            String    @id @default(cuid())
  opportunityId String
  fromStageId   String?
  toStageId     String?
  actorType     ActorType @default(USER)
  ruleId        String?
  reason        String?
  createdAt     DateTime  @default(now())

  opportunity Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage   OpportunityStage? @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage     OpportunityStage? @relation("ToStage", fields: [toStageId], references: [id], onDelete: SetNull)

  @@index([opportunityId, createdAt])
}

model Note {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String?
  body          String
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

// ---------------------------------------------------------------------------
// Technical challenges — the guided workspace
// ---------------------------------------------------------------------------

enum ChallengeStatus {
  NOT_STARTED
  PLANNING
  IN_PROGRESS
  READY_FOR_REVIEW
  SUBMITTED
  PASSED
  FAILED
}

model Challenge {
  id            String          @id @default(cuid())
  userId        String
  opportunityId String
  stageId       String?
  title         String
  /// The brief exactly as they sent it — pasted, uploaded, or pulled from mail.
  brief         String?
  briefSource   String?
  /// The assistant's proposed approach, kept editable.
  plan          String?
  /// Your own working notes.
  notes         String?
  status        ChallengeStatus @default(NOT_STARTED)
  deadline      DateTime?
  estimatedHours Int?
  repoUrl       String?
  submissionUrl String?
  submittedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity  Opportunity           @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  stage        OpportunityStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  requirements ChallengeRequirement[]
  threads      AssistantThread[]

  @@index([userId, status])
  @@index([opportunityId])
}

/// One checkable item extracted from the brief. The assistant proposes these;
/// you tick them off. Explicit requirements are what stops a take-home failing
/// on something that was stated in paragraph four.
model ChallengeRequirement {
  id          String   @id @default(cuid())
  challengeId String
  text        String
  /// "must have" vs "nice to have" as stated in the brief.
  mustHave    Boolean  @default(true)
  done        Boolean  @default(false)
  position    Int
  notes       String?
  /// True when the assistant extracted it rather than you typing it.
  fromBrief   Boolean  @default(true)
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, position])
}

// ---------------------------------------------------------------------------
// The assistant
// ---------------------------------------------------------------------------

model AssistantThread {
  id            String   @id @default(cuid())
  userId        String
  /// Threads are usually scoped to one opportunity or challenge, which is what
  /// gets loaded into the model's context.
  opportunityId String?
  challengeId   String?
  title         String   @default("New conversation")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  challenge   Challenge?         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  messages    AssistantMessage[]

  @@index([userId, updatedAt])
  @@index([opportunityId])
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

model AssistantMessage {
  id       String      @id @default(cuid())
  threadId String
  role     MessageRole
  /// Rendered text. Empty for a pure tool-call turn.
  content  String      @default("")
  /// Raw Anthropic content blocks, replayed verbatim on the next turn.
  blocks   Json?
  /// Human-readable summary of any tools used, for the transcript UI.
  toolSummary String?
  inputTokens  Int?
  outputTokens Int?
  isError   Boolean  @default(false)
  createdAt DateTime @default(now())

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ---------------------------------------------------------------------------
// Google Workspace mirrors
// ---------------------------------------------------------------------------

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model EmailMessage {
  id            String         @id @default(cuid())
  userId        String
  opportunityId String?
  gmailId       String
  threadId      String
  direction     EmailDirection
  subject       String?
  snippet       String?
  bodyText      String?
  fromEmail     String
  fromName      String?
  toEmails      String[]       @default([])
  ccEmails      String[]       @default([])
  labels        String[]       @default([])
  sentAt        DateTime
  createdAt     DateTime       @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@unique([userId, gmailId])
  @@index([opportunityId, sentAt])
  @@index([threadId])
}

enum DraftStatus {
  DRAFT
  SENT
  DISCARDED
}

/// An outbound email awaiting your approval.
///
/// The assistant can only ever create one of these — sending is a separate,
/// explicitly user-triggered action. Nothing leaves your account without a
/// click.
model EmailDraft {
  id            String      @id @default(cuid())
  userId        String
  opportunityId String?
  toEmail       String
  subject       String
  body          String
  threadId      String?
  status        DraftStatus @default(DRAFT)
  /// Why the assistant wrote it, shown above the draft.
  rationale     String?
  createdBy     ActorType   @default(ASSISTANT)
  sentAt        DateTime?
  gmailId       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([opportunityId])
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

model CalendarEvent {
  id             String      @id @default(cuid())
  userId         String
  opportunityId  String?
  stageId        String?
  googleEventId  String
  calendarId     String      @default("primary")
  title          String
  description    String?
  location       String?
  meetLink       String?
  startsAt       DateTime
  endsAt         DateTime
  attendees      String[]    @default([])
  organizerEmail String?
  status         EventStatus @default(CONFIRMED)
  /// Set once the post-event automation has run, so it fires only once.
  completedHandledAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  stage       OpportunityStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@unique([userId, googleEventId])
  @@index([opportunityId, startsAt])
  @@index([startsAt])
}

enum DriveFileKind {
  CV
  COVER_LETTER
  PORTFOLIO
  CHALLENGE_BRIEF
  CHALLENGE_SOLUTION
  OFFER_LETTER
  RESEARCH
  OTHER
}

model DriveFile {
  id            String        @id @default(cuid())
  userId        String
  opportunityId String?
  googleFileId  String
  name          String
  mimeType      String
  kind          DriveFileKind @default(OTHER)
  webViewLink   String?
  iconLink      String?
  sizeBytes     BigInt?
  modifiedAt    DateTime?
  createdAt     DateTime      @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@unique([userId, googleFileId])
  @@index([opportunityId])
}

// ---------------------------------------------------------------------------
// Automation engine
// ---------------------------------------------------------------------------

enum RuleTrigger {
  EMAIL_RECEIVED_FROM_COMPANY
  EMAIL_SENT_TO_COMPANY
  CALENDAR_EVENT_SCHEDULED
  CALENDAR_EVENT_COMPLETED
  CALENDAR_EVENT_CANCELLED
  DRIVE_FILE_ADDED
  STAGE_WENT_QUIET
  OPPORTUNITY_CREATED
}

enum RuleAction {
  ADVANCE_STAGE
  SET_STAGE
  COMPLETE_CURRENT_STAGE
  SET_OPPORTUNITY_STATUS
  SET_NEXT_ACTION
  FLAG_FOR_REVIEW
  LOG_ACTIVITY
}

model AutomationRule {
  id          String      @id @default(cuid())
  userId      String
  name        String
  description String?
  enabled     Boolean     @default(true)
  trigger     RuleTrigger
  action      RuleAction
  /// Evaluation order; lower runs first, first matching rule per trigger wins.
  priority    Int         @default(100)

  /// Free-form matchers, e.g. { "titleContains": ["interview"] }
  conditions Json @default("{}")
  /// Action parameters, e.g. { "stageKey": "tech_interview" }
  config     Json @default("{}")

  timesFired  Int       @default(0)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, trigger, enabled])
}

// ---------------------------------------------------------------------------
// Activity feed & sync bookkeeping
// ---------------------------------------------------------------------------

enum ActivityType {
  OPPORTUNITY_CREATED
  STAGE_CHANGED
  STAGE_COMPLETED
  EMAIL_RECEIVED
  EMAIL_SENT
  DRAFT_CREATED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  INTERVIEW_CANCELLED
  FILE_ATTACHED
  NOTE_ADDED
  CHALLENGE_CREATED
  CHALLENGE_UPDATED
  STATUS_CHANGED
  FLAGGED
  ASSISTANT
  SYNC
}

model Activity {
  id            String       @id @default(cuid())
  userId        String
  opportunityId String?
  type          ActivityType
  actorType     ActorType    @default(SYSTEM)
  title         String
  body          String?
  /// Provenance: gmail message id, calendar event id, drive file id...
  externalId    String?
  meta          Json         @default("{}")
  occurredAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([opportunityId, occurredAt])
}

enum SyncProvider {
  GMAIL
  CALENDAR
  DRIVE
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model SyncRun {
  id          String       @id @default(cuid())
  userId      String
  provider    SyncProvider
  status      SyncStatus   @default(RUNNING)
  itemsSeen   Int          @default(0)
  itemsLinked Int          @default(0)
  rulesFired  Int          @default(0)
  error       String?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, startedAt])
}
