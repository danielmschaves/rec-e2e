# Copy to .env and adjust. Docker Compose reads this file automatically.

# --- Core -------------------------------------------------------------------
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---------------------------------------------------------------
POSTGRES_USER=recruit
POSTGRES_PASSWORD=recruit
POSTGRES_DB=recruitment
# Inside Docker the host is `db`; running Next.js on the host, use localhost.
DATABASE_URL=postgresql://recruit:recruit@localhost:5432/recruitment?schema=public

# --- Queue ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Google Workspace -------------------------------------------------------
# Create an OAuth client (type: Web application) in Google Cloud Console and
# enable the Gmail, Calendar and Drive APIs. Add the redirect URI below to the
# client's authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Serverless (Vercel) ----------------------------------------------------
# Required by /api/cron/sync, which replaces the background worker on Vercel.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Behaviour --------------------------------------------------------------
# Lets you sign in as the seeded demo user without Google credentials.
DEV_LOGIN=true
# Seed demo data on container boot (idempotent).
SEED_ON_BOOT=true
# How often the worker pulls from Google.
SYNC_INTERVAL_MINUTES=5

# --- Local port overrides (optional) ----------------------------------------
WEB_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080
